import customtkinter as ctk
import minecraft_launcher_lib
import os
import subprocess
import threading
import requests
import sys

ctk.set_appearance_mode("Dark")
ctk.set_default_color_theme("blue")

CURRENT_VERSION = "1.3.0"
UPDATE_URL = "https://raw.githubusercontent.com/holholhol/-6-code/main/Malauncher1.3%20obn"

class MaLaun(ctk.CTk):
    def __init__(self):
        super().__init__()
        self.title(f"MaLauncher v{CURRENT_VERSION}")
        self.geometry("800x500")
        self.resizable(False, False)

        self.base_path = r"D:\MaLaun"
        os.makedirs(self.base_path, exist_ok=True)
        self.update_available = False

        self.setup_ui()
        threading.Thread(target=self.check_updates, daemon=True).start()

    def setup_ui(self):
        self.banner = ctk.CTkFrame(self, height=200, fg_color="gray20")
        self.banner.pack(fill="x", padx=10, pady=10)
        self.news_label = ctk.CTkLabel(self.banner, text=f"MaLauncher v{CURRENT_VERSION}\nSelect version and play", font=("Arial", 20))
        self.news_label.pack(expand=True)

        bar = ctk.CTkFrame(self, height=80, fg_color="#333333")
        bar.pack(fill="x", padx=10, pady=10)

        self.user_entry = ctk.CTkEntry(bar, placeholder_text="Username")
        self.user_entry.pack(side="left", padx=10, pady=20)

        try:
            versions = [v['id'] for v in minecraft_launcher_lib.utils.get_version_list() if v['type'] == 'release']
        except Exception:
            versions = ["1.20.1", "1.19.4"]
            
        self.ver_menu = ctk.CTkOptionMenu(bar, values=versions)
        self.ver_menu.pack(side="left", padx=10, pady=20)

        ctk.CTkButton(bar, text="LAUNCH", fg_color="green", width=90, command=self.launch_game).pack(side="right", padx=10, pady=20)
        ctk.CTkButton(bar, text="📁 Mods", width=80, fg_color="gray40", command=self.open_mods).pack(side="right", padx=5, pady=20)
        
        self.upd_btn = ctk.CTkButton(bar, text="🔄 Update", width=100, fg_color="#1f538d", command=self.handle_update)
        self.upd_btn.pack(side="right", padx=5, pady=20)

    def check_updates(self):
        try:
            res = requests.get(UPDATE_URL, timeout=5)
            if res.status_code == 200:
                text = res.text.strip()
                first = text.splitlines()[0] if text else ""
                latest = CURRENT_VERSION
                if "VERSION:" in first:
                    latest = first.split("VERSION:")[1].strip()
                elif len(first) < 10 and "." in first:
                    latest = first.strip()

                if latest != CURRENT_VERSION:
                    self.update_available = True
                    self.news_label.configure(text=f"New version v{latest} available!")
                    self.upd_btn.configure(text=" Update", fg_color="gold", text_color="black")
        except Exception as e:
            print(f"Update check failed: {e}")

    def handle_update(self):
        if not self.update_available:
            threading.Thread(target=self.check_updates, daemon=True).start()
        else:
            threading.Thread(target=self.apply_update, daemon=True).start()

    def apply_update(self):
        try:
            self.news_label.configure(text="Downloading update...")
            res = requests.get(UPDATE_URL)
            if res.status_code == 200:
                with open(os.path.abspath(sys.argv[0]), "w", encoding="utf-8") as f:
                    f.write(res.text)
                self.news_label.configure(text="Restarting...")
                os.execv(sys.executable, [sys.executable] + sys.argv)
        except Exception as e:
            self.news_label.configure(text=f"Update failed: {str(e)[:30]}")

    def open_mods(self):
        mods_path = os.path.join(self.base_path, "mods")
        os.makedirs(mods_path, exist_ok=True)
        os.startfile(mods_path)

    def launch_game(self):
        threading.Thread(target=self._run_game, daemon=True).start()

    def _run_game(self):
        ver = self.ver_menu.get()
        user = self.user_entry.get() or "Player"
        self.news_label.configure(text=f"Preparing {ver}...")
        
        minecraft_launcher_lib.install.install_minecraft_version(ver, self.base_path)
        self.news_label.configure(text=f"Launching {ver}...")
        
        opts = {"Username": user, "uuid": "1", "token": "1", "gameDirectory": self.base_path}
        subprocess.run(minecraft_launcher_lib.command.get_minecraft_command(ver, self.base_path, opts))
        self.news_label.configure(text="Game closed.")

if __name__ == "__main__":
    MaLaun().mainloop()
